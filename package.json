{
  "name": "rapport-inspection",
  "productName": "Rapport Inspection",
  "version": "1.14.8",
  "description": "Application de rédaction des rapports d'évaluation d'inspection pédagogique (discipline Gestion).",
  "author": "haythembenjima",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "dist:portable": "electron-builder --win portable --publish never"
  },
  "dependencies": {
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/share": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "electron": "^31.7.6",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.24.0"
  },
  "build": {
    "appId": "com.inspection.rapports",
    "productName": "Rapport Inspection",
    "files": [
      "index.html",
      "electron/**/*",
      "ocr/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rapport Inspection",
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico",
      "artifactName": "Rapport-Inspection-Setup.${ext}"
    }
  }
}
