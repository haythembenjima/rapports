rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Un utilisateur est « connecté » (enseignant anonyme OU inspecteur).
    function signedIn() {
      return request.auth != null;
    }
    // Un inspecteur est connecté avec un compte e-mail (fournisseur non anonyme).
    // Les enseignants utilisent une connexion anonyme.
    function isInspector() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // ---- Rapports d'inspection : strictement privés à chaque inspecteur. ----
    match /artifacts/{appId}/users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ---- Fiches enseignants ----
    // Créées et mises à jour par les enseignants (anonymes), gérées par les
    // inspecteurs. La SUPPRESSION est réservée aux inspecteurs (empêche un
    // visiteur anonyme d'effacer la base). Un enseignant ne peut pas modifier
    // le « code » d'identité d'une fiche (anti-détournement).
    // NOTE : la lecture reste ouverte aux utilisateurs connectés car
    // l'enseignant retrouve sa fiche par code depuis un autre appareil et
    // l'inspecteur liste ses fiches ; fermer la lecture demande des Cloud
    // Functions (voir documentation du projet).
    match /artifacts/{appId}/public/data/enseignants/{fiche} {
      allow read:   if signedIn();
      allow create: if signedIn();
      allow update: if isInspector()
                    || (signedIn() && request.resource.data.code == resource.data.code);
      allow delete: if isInspector();
    }

    // ---- Corbeille ----
    // Contient des données personnelles de fiches supprimées : réservée aux
    // inspecteurs (les enseignants n'y accèdent jamais).
    match /artifacts/{appId}/public/data/enseignants_corbeille/{fiche} {
      allow read, write: if isInspector();
    }

    // ---- Profils inspecteurs (code d'accès + config EmailJS) ----
    // Lecture nécessaire aux enseignants pour l'envoi automatique du code par
    // e-mail (EmailJS s'exécute dans le navigateur de l'enseignant ; la clé
    // « publique » EmailJS est conçue pour être exposée côté client).
    // Écriture limitée au propriétaire du document.
    match /artifacts/{appId}/public/data/enseignants_config/{docId} {
      allow read:  if signedIn();
      allow write: if request.auth != null && docId == 'insp_' + request.auth.uid;
    }

    // ---- Suivi de visite : bloc privé de l'inspecteur. ----
    match /artifacts/{appId}/public/data/enseignants_suivi/{ficheId} {
      allow read, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && request.resource.data.ownerUid == request.auth.uid && (resource.data.ownerUid == request.auth.uid || !('ownerUid' in resource.data));
    }
  }
}
